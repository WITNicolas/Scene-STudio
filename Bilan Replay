function findClosest(points,t){var c=null,d=Infinity;points.forEach(function(p){var x=Math.abs(p.timestamp-t);if(x<d){d=x;c=p;}});return d<=90*60*1000?c:null;}
function togglePlayback(){if(playing){stopPlayback();return;}var pts=validPoints();if(!pts.length)return;if(selectedPointIndex>=pts.length-1)selectedPointIndex=0;playing=true;setText("replayPlay","II Pause");playTimer=setInterval(function(){selectedPointIndex++;if(selectedPointIndex>=pts.length){selectedPointIndex=pts.length-1;stopPlayback();}selectPoint(selectedPointIndex);},550);}
function stopPlayback(){playing=false;if(playTimer){clearInterval(playTimer);playTimer=null;}setText("replayPlay","▶ Lecture");}
function updatePeriodButtons(){Array.prototype.forEach.call(document.querySelectorAll(".replay-period-button"),function(b){b.classList.toggle("active",b.getAttribute("data-period")===selectedPeriod);});}
function updatePeriodInfo(range,fileCount){setText("replayPeriodLabel",range.label);setText("replayFileBadge",fileCount+" fichier(s)");setText("replayRowBadge",mergedRows.length+" index fusionne(s)");var s=document.getElementById("replayBilanSelect");setText("replaySourceBadge",s.options[s.selectedIndex].textContent);document.getElementById("replayPreviousPeriod").disabled=selectedPeriod==="all"||range.start.getTime()<=firstDay().getTime();document.getElementById("replayNextPeriod").disabled=selectedPeriod==="all"||range.end.getTime()>=addDays(lastDay(),1).getTime();}
function clearData(){seriesList=[];mergedRows=[];selectedSeriesIndex=0;selectedPointIndex=0;var m=document.getElementById("replaySeriesMenu");if(m)m.innerHTML="";clearChart();}
function clearChart(){if(chart){chart.data.labels=[];chart.data.datasets[0].data=[];chart.update();}}
function showEmpty(msg){clearChart();["replayCurrentValue","replayCurrentIndex","replayMaximum","replayAverage"].forEach(function(id){setText(id,"0");});setText("replayCurrentMeta","Aucun intervalle");setText("replayDetailText",msg);setText("replaySelectedBadge","Aucun point");setText("replayPointCounter","0 / 0");setStatus(msg,"#f59e0b");}
function setLoading(text){setText("replayLoadingBadge",text);}
function setStatus(text,color){setText("replayStatusText",text);var d=document.getElementById("replayStatusDot");if(d)d.style.background=color;}
function showRuntimeError(error){console.error("Energy Replay :",error);setLoading("Erreur de chargement");setText("replayDetailText",getError(error));setStatus("Erreur : "+getError(error),"#ef4444");}
function showFatal(error){console.error(error);html1.properties.content='<div class="replay-error"><h2>Erreur Energy Replay</h2><pre>'+escapeHtml(getError(error))+'</pre></div>';}
function median(values){if(!values.length)return 0;var s=values.slice().sort(function(a,b){return a-b;}),m=Math.floor(s.length/2);return s.length%2?s[m]:(s[m-1]+s[m])/2;}
function startOfDay(d){return new Date(d.getFullYear(),d.getMonth(),d.getDate(),0,0,0,0);}
function addDays(d,n){var r=new Date(d.getTime());r.setDate(r.getDate()+n);return r;}
function formatAxisLabel(d){if(selectedPeriod==="today"||selectedPeriod==="yesterday")return formatTime(d);if(selectedPeriod==="7days")return d.toLocaleString("fr-FR",{weekday:"short",hour:"2-digit"});return d.toLocaleString("fr-FR",{day:"2-digit",month:"2-digit",hour:"2-digit"});}
function formatNumber(v){return isFinite(v)?Number(v).toLocaleString("fr-FR",{maximumFractionDigits:3}):"N/A";}
function formatDate(d){return d.toLocaleString("fr-FR",{day:"2-digit",month:"2-digit",year:"numeric",hour:"2-digit",minute:"2-digit"});}
function formatDay(d){return d.toLocaleDateString("fr-FR",{day:"2-digit",month:"2-digit",year:"numeric"});}
function formatTime(d){return d.toLocaleTimeString("fr-FR",{hour:"2-digit",minute:"2-digit"});}
function setText(id,text){var e=document.getElementById(id);if(e)e.textContent=text;}
function escapeHtml(v){return String(v===undefined||v===null?"":v).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;");}
function getError(e){return e&&e.message?e.message:String(e);}
function waitForElement(id,max){return new Promise(function(resolve,reject){var n=0;(function test(){var e=document.getElementById(id);if(e)return resolve(e);if(++n>=max)return reject(new Error("Element "+id+" introuvable."));setTimeout(test,100);})();});}
