    document.getElementById("replayNextPeriod").addEventListener("click",function(){if(selectedPeriod!=="all"){periodShift++;loadPeriod().catch(showRuntimeError);}});
    document.getElementById("replayFirst").addEventListener("click",function(){stopPlayback();selectPoint(0);});
    document.getElementById("replayPrevious").addEventListener("click",function(){stopPlayback();selectPoint(selectedPointIndex-1);});
