}
function renderDashboard(){
    var data=computeInsights(),top=data.top,topShare=data.grandTotal&&top?top.total/data.grandTotal*100:0,anRate=data.allPoints.length?data.anomalies.length/data.allPoints.length*100:0,nightShare=data.grandTotal?data.overnight/data.grandTotal*100:0;
    setText("ayTotal",formatNumber(data.grandTotal));setText("ayTotalMeta",data.allPoints.length+" intervalle(s) valide(s)");setText("ayTopShare",formatNumber(topShare)+" %");setText("ayTopName",top?top.series.name:"Aucun usage");setText("ayAnomalies",data.anomalies.length);setText("ayAnomalyRate",formatNumber(anRate)+" % des intervalles");setText("ayNightShare",formatNumber(nightShare)+" %");setText("ayPeak",data.peak?formatNumber(data.peak.point.delta):"0");setText("ayPeakMeta",data.peak?data.peak.series.name+" | "+formatDate(data.peak.point.date):"Aucun pic");setText("ayParetoBadge",data.totals.length+" usage(s)");
    drawPareto(data);drawProfile();renderRanking(data);renderInsights(data);setText("ayStatusText","Analyse calculée à partir des deltas REDY valides de la période.");
}
function drawPareto(data){
    var labels=data.totals.map(function(x){return x.series.name;}),values=data.totals.map(function(x){return x.total;}),colors=data.totals.map(function(x){return x.series.color;});
    if(!chart){chart=new Chart(document.getElementById("ayParetoCanvas").getContext("2d"),{type:"bar",data:{labels:labels,datasets:[{data:values,backgroundColor:colors,borderRadius:5}]},options:{indexAxis:"y",responsive:true,maintainAspectRatio:false,animation:false,scales:{x:{beginAtZero:true,grid:{color:"#edf1f5"},ticks:{callback:function(v){return formatNumber(Number(v));}}},y:{grid:{display:false}}},plugins:{legend:{display:false},tooltip:{callbacks:{label:function(c){var pct=data.grandTotal?c.parsed.x/data.grandTotal*100:0;return formatNumber(c.parsed.x)+" | "+formatNumber(pct)+" %";}}}}}});}else{chart.data.labels=labels;chart.data.datasets[0].data=values;chart.data.datasets[0].backgroundColor=colors;chart.update("none");}
}
function drawProfile(){
    var selectedSeries = selectedSeriesIndex >= 0 && seriesList[selectedSeriesIndex]
        ? seriesList[selectedSeriesIndex]
        : null;

    var profileName = selectedSeries ? selectedSeries.name : "Global";
    var profileColor = selectedSeries ? selectedSeries.color : "#149fe3";
    var profilePoints = [];

    if(selectedSeries){
        profilePoints = selectedSeries.points.slice().sort(function(a,b){
            return a.timestamp - b.timestamp;
        });
    } else {
        var timeline = {};

        seriesList.forEach(function(series){
            series.points.forEach(function(point){
                var key = String(point.timestamp);

                if(!timeline[key]){
                    timeline[key] = {
                        date: point.date,
                        timestamp: point.timestamp,
                        delta: 0,
                        rawDelta: 0,
                        validDelta: false,
                        baselineDetected: false,
                        baselineReason: "",
                        validSeriesCount: 0,
                        invalidSeriesCount: 0
                    };
                }

                var target = timeline[key];

                if(point.validDelta && point.delta !== null && isFinite(point.delta) && point.delta >= 0){
                    target.delta += point.delta;
                    target.rawDelta += point.delta;
                    target.validDelta = true;
                    target.validSeriesCount++;
                } else {
                    target.invalidSeriesCount++;
                    if(point.baselineDetected){
                        target.baselineDetected = true;
                        target.baselineReason = point.baselineReason || "Valeur initiale non vérifiable";
                        if(point.rawDelta !== undefined && point.rawDelta !== null && isFinite(point.rawDelta)){
                            target.rawDelta += point.rawDelta;
                        }
                    }
                }
            });
        });

        profilePoints = Object.keys(timeline).map(function(key){
            return timeline[key];
        }).sort(function(a,b){
            return a.timestamp - b.timestamp;
        });
    }

    var labels = [];
    var values = [];

    profilePoints.forEach(function(point){
        labels.push(point.date.toLocaleString("fr-FR",{
            day:"2-digit",
            month:"2-digit",
            year:"numeric",
            hour:"2-digit",
            minute:"2-digit"
        }));

        values.push(
            point.validDelta && point.delta !== null && isFinite(point.delta) && point.delta >= 0
                ? point.delta
                : null
        );
    });

    var periodLabel = {
        today:"Aujourd'hui",
        yesterday:"Hier",
        "7days":"7 jours",
        "30days":"30 jours",
        all:"Toute la période"
    }[selectedPeriod] || "";

    var title = document.getElementById("ayProfileTitle");
    if(title){
        title.textContent = selectedSeries
            ? "Profil - " + selectedSeries.name + " (" + periodLabel + ")"
            : "Profil (" + periodLabel + ")";
    }

    var subtitle = document.getElementById("ayProfileSubtitle");
    if(subtitle){
        subtitle.textContent = "Données horaires réelles de la période sélectionnée";
    }

    var canvas = document.getElementById("ayProfileCanvas");
    if(!canvas) return;

    var maxTicks = selectedPeriod === "today" || selectedPeriod === "yesterday" ? 12 : 20;

    if(hourChart){
        hourChart.destroy();
        hourChart = null;
    }

    hourChart = new Chart(canvas.getContext("2d"),{
        type:"line",
        data:{
            labels:labels,
            datasets:[{
                label:profileName,
                data:values,
                borderColor:profileColor,
                backgroundColor:hexToRgba(profileColor,0.14),
                fill:true,
                tension:0.15,
                pointRadius:0,
                pointHoverRadius:4,
                spanGaps:false
            }]
        },
        options:{
            responsive:true,
            maintainAspectRatio:false,
            animation:false,
            interaction:{intersect:false,mode:"index"},
            scales:{
                x:{
                    ticks:{maxTicksLimit:maxTicks,maxRotation:45,minRotation:0},
                    grid:{display:false}
                },
                y:{
                    beginAtZero:true,
                    grid:{color:"#edf1f5"},
                    ticks:{callback:function(value){return formatNumber(Number(value));}}
                }
            },
            plugins:{
                legend:{display:true},
                tooltip:{
                    callbacks:{
                        title:function(items){
                            if(!items || !items.length) return "";
                            var point = profilePoints[items[0].dataIndex];
                            return point && point.date ? point.date.toLocaleString("fr-FR") : "";
                        },
                        label:function(item){
                            var point = profilePoints[item.dataIndex];
                            if(!point || !point.validDelta || item.raw === null){
                                return profileName + " : donnée non vérifiable";
                            }
                            return profileName + " : " + formatNumber(Number(item.raw));
                        },
                        afterLabel:function(item){
                            var point = profilePoints[item.dataIndex];
                            if(!point || !point.baselineDetected) return "";
                            var raw = point.rawDelta;
                            return raw !== undefined && raw !== null && isFinite(raw)
                                ? "Valeur brute initiale exclue : " + formatNumber(raw)
                                : "Valeur initiale exclue";
                        }
                    }
                }
            }
        }
    });
}
function renderRanking(data){
    var html='<table class="ay-table"><thead><tr><th>Usage</th><th>Total</th><th>Part</th><th>Anomalies</th></tr></thead><tbody>';
    data.totals.forEach(function(x){var pct=data.grandTotal?x.total/data.grandTotal*100:0;html+='<tr><td><span class="ay-dot" style="background:'+x.series.color+'"></span>'+escapeHtml(x.series.name)+'</td><td>'+formatNumber(x.total)+'</td><td>'+formatNumber(pct)+' %</td><td>'+x.anomalies+'</td></tr>';});
    document.getElementById("ayRanking").innerHTML=html+'</tbody></table>';
}
function renderInsights(data){
    var box=document.getElementById("ayInsights"),html="";
    if(data.top){var share=data.grandTotal?data.top.total/data.grandTotal*100:0;html+=insight("Usage prioritaire",data.top.series.name+" represente "+formatNumber(share)+" % de la consommation totale.",share>=50?"warning":"");}
    var nightShare=data.grandTotal?data.overnight/data.grandTotal*100:0;html+=insight("Consommation nocturne",formatNumber(nightShare)+" % de la consommation est observee entre 22h et 06h.",nightShare>=25?"warning":"");
    if(data.anomalies.length){var a=data.anomalies[0];html+=insight("Anomalie prioritaire",a.series.name+" le "+formatDate(a.point.date)+", score "+formatNumber(a.point.score)+".",a.point.severity==="critical"?"critical":"warning");}else{html+=insight("Anomalies","Aucune anomalie ne depasse les seuils configures sur la periode.","");}
    if(data.peak)html+=insight("Pic global",data.peak.series.name+" atteint "+formatNumber(data.peak.point.delta)+" le "+formatDate(data.peak.point.date)+".","");
    box.innerHTML=html;
}
