function formatAxisLabel(d){if(selectedPeriod==="today"||selectedPeriod==="yesterday")return formatTime(d);if(selectedPeriod==="7days")return d.toLocaleString("fr-FR",{weekday:"short",hour:"2-digit"});return d.toLocaleString("fr-FR",{day:"2-digit",month:"2-digit",hour:"2-digit"});}
function formatNumber(v){return isFinite(v)?Number(v).toLocaleString("fr-FR",{maximumFractionDigits:2}):"N/A";}
