            '<label for="ayV6Price">Prix energie</label><input id="ayV6Price" class="ay-v6-input" inputmode="decimal" value="0,18"><span class="ay-panel-subtitle">EUR/kWh</span>'+
            '<label for="ayV6Mode">Mode</label><select id="ayV6Mode" class="ay-v6-select"><option value="exploitant">Exploitant</option><option value="direction">Direction</option></select>'+
            '<button id="ayHelp" class="ay-v5-button" type="button">❔ Aide</button>'+
loading+
'</div>';
        return content.replace(loading,replacement);
    }

    function addV6DirectionTab(content){
        var pilotTab='<button class="analyst-v3-tab" type="button" data-tab="pilotage" role="tab">Pilotage</button>';
        content=content.replace(pilotTab,pilotTab+'<button class="analyst-v3-tab" type="button" data-tab="direction" role="tab">Direction</button>');
        var end=content.lastIndexOf("</div>");if(end<0)return content;
        var view=[
            '<div class="ay-v3-view" id="analystDirectionView" data-view="direction" hidden>',
            '<div class="ay-v6-kpis">',
            '<div class="ay-v6-kpi primary"><div class="ay-v6-kpi-label">Cout de la periode</div><div class="ay-v6-kpi-value" id="ayV6Cost">0 EUR</div><div class="ay-v6-kpi-meta" id="ayV6CostMeta">Prix configurable</div></div>',
            '<div class="ay-v6-kpi"><div class="ay-v6-kpi-label">Projection annuelle</div><div class="ay-v6-kpi-value" id="ayV6AnnualEnergy">0</div><div class="ay-v6-kpi-meta" id="ayV6AnnualEnergyMeta">Extrapolation des jours disponibles</div></div>',
            '<div class="ay-v6-kpi"><div class="ay-v6-kpi-label">Budget annuel projete</div><div class="ay-v6-kpi-value" id="ayV6AnnualCost">0 EUR</div><div class="ay-v6-kpi-meta">Projection au prix energie saisi</div></div>',
            '<div class="ay-v6-kpi warning"><div class="ay-v6-kpi-label">Derive maximale</div><div class="ay-v6-kpi-value" id="ayV6MaxDrift">0 %</div><div class="ay-v6-kpi-meta" id="ayV6MaxDriftMeta">Premiere vs seconde moitie</div></div>',
            '</div>',
            '<div class="ay-v6-columns">',
            '<div class="ay-panel"><div class="ay-panel-header"><div><div class="ay-panel-title">Derives par usage</div><div class="ay-panel-subtitle">Evolution entre les deux moities de la periode selectionnee</div></div></div><div class="ay-v6-list" id="ayV6Drifts"></div></div>',
            '<div class="ay-panel"><div class="ay-panel-header"><div><div class="ay-panel-title">Timeline des evenements</div><div class="ay-panel-subtitle">Pics et anomalies tries chronologiquement</div></div></div><div class="ay-v6-timeline" id="ayV6Timeline"></div></div>',
            '</div>',
