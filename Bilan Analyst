function buildSeriesFromIndexes(merged){

    /*
     * Les valeurs REDY présentes dans les fichiers sont utilisées
     * directement comme deltas.
     *
     * La première valeur positive d'une série est toutefois non
     * vérifiable si aucune donnée de cette série n'existe pendant
     * la journée civile précédente.
     *
     * Cette valeur est conservée dans rawDelta pour la traçabilité,
     * mais elle est exclue des calculs avec validDelta = false.
     */

    return merged.headers.map(function(header, col){

        var points = [];

        merged.rows.forEach(function(row){

            var value = row.values[col];

            if(
                value === null ||
                value === undefined ||
                !isFinite(value)
            ){
                return;
            }

            points.push({
                indexValue: value,

                /*
                 * Valeur brute exacte provenant du fichier REDY.
                 */
                rawDelta: value,

                /*
                 * Delta utilisé par Analyst.
                 * La valeur reste inchangée tant qu'elle est vérifiable.
                 */
                delta: value,

                date: row.date,
                timestamp: row.timestamp,
                label: row.dateText,
                duration: null,

                validDelta: value >= 0,
                resetDetected: false,
                gapDetected: false,
                baselineDetected: false,
                baselineReason: "",

                reference: null,
                deviation: null,
                score: 0,
                severity: "normal"
            });
        });

        /*
         * Tri chronologique.
         */
        points.sort(function(a, b){
            return a.timestamp - b.timestamp;
        });

        /*
         * Calcul de la durée entre deux enregistrements.
         */
        for(var i = 1; i < points.length; i++){

            points[i].duration =
                points[i].timestamp -
                points[i - 1].timestamp;
        }

        /*
         * Détection des trous dans l'historique.
         */
        var durations = points
            .map(function(point){
                return point.duration;
            })
            .filter(function(duration){
                return duration > 0;
            });

        var normalDuration = median(durations);

        points.forEach(function(point){

            point.gapDetected =
                normalDuration > 0 &&
                point.duration !== null &&
                point.duration > normalDuration * 1.5;
        });

        /*
         * Recherche de la première valeur positive de la série.
         */
        var firstPositiveIndex = -1;

        for(
            var positiveIndex = 0;
            positiveIndex < points.length;
            positiveIndex++
        ){

            if(
                points[positiveIndex].validDelta &&
                points[positiveIndex].delta > 0
            ){
                firstPositiveIndex = positiveIndex;
                break;
            }
        }

        if(firstPositiveIndex >= 0){

            var firstPositivePoint =
                points[firstPositiveIndex];

            /*
             * Journée contenant la première valeur positive.
             */
            var currentDayStart =
                startOfDay(firstPositivePoint.date);

            /*
             * Bornes de la journée civile précédente.
             *
             * Exemple :
             * première valeur positive le 21/08 à 18:00
             * recherche entre :
             * 20/08 à 00:00 inclus
             * 21/08 à 00:00 exclu
             */
            var previousDayStart =
                addDays(currentDayStart, -1);

            var previousDayEnd =
                currentDayStart;

            /*
             * Teste l'existence réelle d'au moins une donnée pour
             * cette série pendant la journée précédente.
             *
             * Une valeur égale à zéro compte comme une donnée existante.
             * Une cellule absente, vide ou non numérique ne compte pas.
             */
            var hasPreviousDayData =
                points.some(function(point){

                    return (
                        point.timestamp >=
                            previousDayStart.getTime() &&

                        point.timestamp <
                            previousDayEnd.getTime() &&

                        point.indexValue !== null &&
                        point.indexValue !== undefined &&
                        isFinite(point.indexValue)
                    );
                });

            /*
             * Sans journée précédente, la première valeur positive
             * ne peut pas être attribuée à un intervalle horaire fiable.
             *
             * On conserve sa valeur brute, mais on l'exclut de tous
             * les calculs énergétiques.
             */
            if(!hasPreviousDayData){

                firstPositivePoint.validDelta = false;
                firstPositivePoint.baselineDetected = true;

                firstPositivePoint.baselineReason =
                    "Valeur brute d'initialisation : aucune donnée " +
                    "disponible sur la journée civile précédente";

                firstPositivePoint.reference = null;
                firstPositivePoint.deviation = null;
                firstPositivePoint.score = 0;
                firstPositivePoint.severity = "normal";

                console.warn(
                    "Analyst : première valeur non exploitable",
                    {
                        serie:
                            header ||
                            ("Mesure " + (col + 1)),

                        date:
                            firstPositivePoint.date
                                .toLocaleString("fr-FR"),

                        valeurBrute:
                            firstPositivePoint.rawDelta,

                        jourPrecedentRecherche:
                            previousDayStart
                                .toLocaleDateString("fr-FR"),

                        raison:
                            firstPositivePoint.baselineReason
                    }
                );
            }
        }

        return {
            name:
                header ||
                ("Mesure " + (col + 1)),

            color:
                COLORS[col % COLORS.length],

            points:
                points
        };
    });
