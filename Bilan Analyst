    function applyDisplayMode(){
        var root=document.getElementById("analystDashboard");if(!root)return;
        root.classList.toggle("ay-mode-direction",displayMode==="direction");
        if(displayMode==="direction"){
            var directionTab=document.querySelector('.analyst-v3-tab[data-tab="direction"]');
            if(directionTab)directionTab.click();
        }
    }

    function renderV6(){
        var view=document.getElementById("analystDirectionView");if(!view||!seriesList.length)return;
        var data=computeInsights();
        var days=countCoveredDays(data.allPoints);
        var dailyAverage=days?data.grandTotal/days:0;
        var annualEnergy=dailyAverage*365;
        var cost=data.grandTotal*energyPrice;
        var annualCost=annualEnergy*energyPrice;
        var drifts=computeSeriesDrifts();
        var maxDrift=drifts.length?drifts.slice().sort(function(a,b){return b.drift-a.drift;})[0]:null;
        setText("ayV6Cost",formatCurrency(cost));
        setText("ayV6CostMeta",formatNumber(data.grandTotal)+" kWh x "+formatNumber(energyPrice)+" EUR/kWh");
        setText("ayV6AnnualEnergy",formatNumber(annualEnergy)+" kWh");
        setText("ayV6AnnualEnergyMeta","Extrapolation de "+days+" jour(s) couvert(s)");
        setText("ayV6AnnualCost",formatCurrency(annualCost));
        setText("ayV6MaxDrift",maxDrift?(maxDrift.drift>=0?"+":"")+formatNumber(maxDrift.drift)+" %":"0 %");
        setText("ayV6MaxDriftMeta",maxDrift?maxDrift.series.name:"Donnees insuffisantes");
        renderDrifts(drifts);
        renderTimeline(data);
        renderPriorityActions(data,drifts,cost);
    }

    function countCoveredDays(points){
        var seen={};points.forEach(function(x){seen[formatDay(x.point.date)]=true;});return Object.keys(seen).length;
    }

    function computeSeriesDrifts(){
        return seriesList.map(function(series){
            var points=validPointsForSeries(series).slice().sort(function(a,b){return a.timestamp-b.timestamp;});
            if(points.length<2)return {series:series,first:0,second:0,drift:0,valid:false};
            var mid=points[Math.floor(points.length/2)].timestamp,first=0,second=0;
            points.forEach(function(p){if(p.timestamp<mid)first+=p.delta;else second+=p.delta;});
            return {series:series,first:first,second:second,drift:first?(second-first)/first*100:0,valid:first>0};
        }).filter(function(x){return x.valid;}).sort(function(a,b){return b.drift-a.drift;});
    }

    function renderDrifts(drifts){
        var box=document.getElementById("ayV6Drifts");if(!box)return;
        if(!drifts.length){box.innerHTML='<div class="ay-empty">Donnees insuffisantes pour calculer les derives.</div>';return;}
        var max=Math.max.apply(Math,drifts.map(function(x){return Math.abs(x.drift);}));
        box.innerHTML=drifts.map(function(x){var width=max?Math.abs(x.drift)/max*100:0;return '<div class="ay-v6-item"><div class="ay-v6-name"><span class="ay-dot" style="background:'+x.series.color+'"></span>'+escapeHtml(x.series.name)+'</div><div class="ay-v6-bar"><span style="width:'+width+'%;background:'+x.series.color+'"></span></div><div class="ay-v6-delta '+(x.drift>0?'up':'down')+'">'+(x.drift>=0?'+':'')+escapeHtml(formatNumber(x.drift))+' %</div></div>';}).join("");
    }

    function renderTimeline(data){
        var box=document.getElementById("ayV6Timeline");if(!box)return;
        var events=data.anomalies.slice(0,15).map(function(x){return {date:x.point.date,title:(x.point.severity==="critical"?"Anomalie critique":"Anomalie a surveiller")+" - "+x.series.name,meta:"Valeur "+formatNumber(x.point.delta)+", score "+formatNumber(x.point.score),level:x.point.severity};});
        if(data.peak)events.push({date:data.peak.point.date,title:"Pic global - "+data.peak.series.name,meta:"Valeur "+formatNumber(data.peak.point.delta),level:""});
        events.sort(function(a,b){return b.date-a.date;});
        if(!events.length){box.innerHTML='<div class="ay-empty">Aucun evenement prioritaire sur la periode.</div>';return;}
        box.innerHTML=events.slice(0,12).map(function(e){return '<div class="ay-v6-event '+e.level+'"><div class="ay-v6-event-title">'+escapeHtml(e.title)+'</div><div class="ay-v6-event-meta">'+escapeHtml(formatDate(e.date))+' | '+escapeHtml(e.meta)+'</div></div>';}).join("");
    }

    function renderPriorityActions(data,drifts,cost){
        var box=document.getElementById("ayV6Actions");if(!box)return;
        var actions=[];
        var nightShare=data.grandTotal?data.overnight/data.grandTotal*100:0;
        if(nightShare>=15)actions.push({title:"Reduire les consommations nocturnes",text:formatNumber(nightShare)+" % de la consommation est observee entre 22h et 06h. Verifier horaires, veilles et arrets.",level:nightShare>=25?"critical":"warning"});
        if(data.top){var share=data.grandTotal?data.top.total/data.grandTotal*100:0;actions.push({title:"Prioriser "+data.top.series.name,text:"Cet usage represente "+formatNumber(share)+" % de la consommation et environ "+formatCurrency(data.top.total*energyPrice)+" sur la periode.",level:share>=50?"warning":""});}
        if(drifts.length&&drifts[0].drift>=10)actions.push({title:"Analyser la derive de "+drifts[0].series.name,text:"La seconde moitie de la periode est superieure de "+formatNumber(drifts[0].drift)+" % a la premiere.",level:drifts[0].drift>=25?"critical":"warning"});
        if(data.anomalies.length)actions.push({title:"Traiter les anomalies",text:data.anomalies.length+" intervalle(s) depassent les seuils. Commencer par "+data.anomalies[0].series.name+" le "+formatDate(data.anomalies[0].point.date)+".",level:data.anomalies[0].point.severity});
        if(!actions.length)actions.push({title:"Maintenir la surveillance",text:"Aucune priorite forte n est detectee avec les seuils actuels. Continuer le suivi periodique.",level:""});
        setText("ayV6ActionBadge",actions.length+" action(s)");
        box.innerHTML=actions.slice(0,6).map(function(x,i){return '<div class="ay-v6-action '+x.level+'"><div class="ay-v6-action-rank">Priorite '+(i+1)+'</div><div class="ay-v6-action-title">'+escapeHtml(x.title)+'</div><div class="ay-v6-action-text">'+escapeHtml(x.text)+'</div></div>';}).join("");
    }

    function formatCurrency(value){return isFinite(value)?Number(value).toLocaleString("fr-FR",{style:"currency",currency:"EUR",maximumFractionDigits:0}):"N/A";}
})();
