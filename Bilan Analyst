    Array.prototype.forEach.call(document.querySelectorAll(".analyst-period-button"),function(b){b.addEventListener("click",function(){selectedPeriod=b.getAttribute("data-period");periodShift=0;updatePeriodButtons();loadPeriod().catch(showRuntimeError);});});
    document.getElementById("analystPreviousPeriod").addEventListener("click",function(){if(selectedPeriod!=="all"){periodShift--;loadPeriod().catch(showRuntimeError);}});
    document.getElementById("analystNextPeriod").addEventListener("click",function(){if(selectedPeriod!=="all"){periodShift++;loadPeriod().catch(showRuntimeError);}});
}
function renderSeriesButtons(){
    var menu=document.getElementById("analystSeriesMenu");if(!menu)return;menu.innerHTML="";
    var globalButton=document.createElement("button");
    globalButton.className="analyst-series-button"+(selectedSeriesIndex===-1?" active":"");
    globalButton.style.setProperty("--series-color","#149fe3");
