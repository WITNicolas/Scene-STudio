function hexToRgba(hex,alpha){var h=String(hex||"#149fe3").replace("#","");if(h.length===3)h=h.split("").map(function(c){return c+c;}).join("");var n=parseInt(h,16);if(!isFinite(n))return "rgba(20,159,227,"+alpha+")";return "rgba("+((n>>16)&255)+","+((n>>8)&255)+","+(n&255)+","+alpha+")";}
