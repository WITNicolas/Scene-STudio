(function installAnalystV5SinglePage() {
    "use strict";

    var activeAnalystTab = "overview";

    if (typeof injectHtml !== "function" ||
        typeof bindEvents !== "function" ||
        typeof renderDashboard !== "function") {
        console.error("Analyst V5 : fonctions de base introuvables.");
        return;
    }

    var originalInjectHtml = injectHtml;
    var originalBindEvents = bindEvents;
    var originalRenderDashboard = renderDashboard;

    injectHtml = function () {
        originalInjectHtml();

        var content = String(html1.properties.content || "");
        content = removePreviousViewSelector(content);
        content = addV3Styles(content);
        content = identifyExistingViews(content);
        content = addTabsAndAnomalyView(content);
        content = content.replace("Analyst V2</div>", "Analyst V5</div>");
        content = content.replace(
            "Synthese energetique, priorites et recommandations automatiques",
            "Une page unique pour explorer les usages, profils et anomalies"
        );

        html1.properties.content = content;
    };

    bindEvents = function () {
        originalBindEvents();

        Array.prototype.forEach.call(
            document.querySelectorAll(".analyst-v3-tab"),
            function (button) {
                button.addEventListener("click", function () {
                    activeAnalystTab = button.getAttribute("data-tab") || "overview";
                    updateAnalystTab();
                });
            }
        );

        updateAnalystTab();
    };

    renderDashboard = function () {
        originalRenderDashboard();
        renderAnomalyView();
        updateAnalystTab();
    };

    function removePreviousViewSelector(content) {
        content = content.replace(
            /<div class="ay-view-selector">[\s\S]*?<div class="ay-badge" id="analystLoadingBadge">Chargement<\/div>[\s\S]*?<\/div>/,
            '<div class="ay-badge" id="analystLoadingBadge">Chargement</div>'
        );
        return content;
    }

    function addV3Styles(content) {
        var css = [
