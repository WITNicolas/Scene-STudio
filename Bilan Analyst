function renderWeeklyHeatmap(box, points){

    var cells = [];

    for(var d=0; d<7; d++){

        cells[d] = [];

        for(var h=0; h<24; h++){
            cells[d][h] = [];
        }
    }

    points.forEach(function(p){

        var day =
            (p.date.getDay() + 6) % 7;

        cells[day][p.date.getHours()]
            .push(p.delta);

    });

    var averages = [];
    var maxValue = 0;

    for(var d=0; d<7; d++){

        averages[d] = [];

        for(var h=0; h<24; h++){

            var values = cells[d][h];

            var avg =
                values.length
                    ? values.reduce(function(a,b){
                        return a+b;
                      },0) / values.length
                    : 0;

            averages[d][h] = avg;

            if(avg > maxValue){
                maxValue = avg;
            }
        }
    }

    var days = [
        "Lun",
        "Mar",
        "Mer",
        "Jeu",
        "Ven",
        "Sam",
        "Dim"
    ];

    var html =
        '<table class="ay-heatmap">';

    html += '<thead><tr><th>Jour</th>';

    for(var h=0; h<24; h++){

        html +=
            '<th>' +
            String(h).padStart(2,"0") +
            'h</th>';

    }

    html += '</tr></thead><tbody>';

    for(var d=0; d<7; d++){

        html += '<tr>';

        html += '<th>' + days[d] + '</th>';

        for(var h=0; h<24; h++){

            var value = averages[d][h];

            var ratio =
                maxValue
                    ? value/maxValue
                    : 0;

            html +=
                '<td style="background:' +
                heatColor(ratio) +
                '">' +
                (value
                    ? formatNumber(value)
                    : ''
                ) +
                '</td>';
        }

        html += '</tr>';
    }

    html += '</tbody></table>';

    box.innerHTML = html;
}



function renderCalendarHeatmap(box, points){

    var startDate = selectedRange().start;
    var endDate   = selectedRange().end;

    var rows = {};
    var maxValue = 0;

    /*
     * création de toutes les dates
     */

    var current =
        new Date(startDate.getTime());

    while(current < endDate){

        var key = formatDay(current);

        rows[key] = [];

        for(var h=0; h<24; h++){
            rows[key][h] = 0;
        }

        current =
            addDays(current,1);
    }

    /*
     * alimentation
     */

    points.forEach(function(p){

        var key =
            formatDay(p.date);

        if(!rows[key]) return;

        var hour =
            p.date.getHours();

        rows[key][hour] += p.delta;

        if(rows[key][hour] > maxValue){

            maxValue =
                rows[key][hour];
        }

    });

    var html =
        '<div style="max-height:650px;overflow:auto;">';

    html +=
        '<table class="ay-heatmap">';

    html +=
        '<thead><tr><th>Date</th>';

    for(var h=0; h<24; h++){

        html +=
            '<th>' +
            String(h).padStart(2,"0") +
            'h</th>';

    }

    html +=
        '</tr></thead><tbody>';

    Object.keys(rows).forEach(function(day){

        html += '<tr>';

        html +=
            '<th>' +
            day +
            '</th>';

        for(var h=0; h<24; h++){

            var value =
                rows[day][h];

            var ratio =
                maxValue
                    ? value/maxValue
                    : 0;

            html +=
                '<td style="background:' +
                heatColor(ratio) +
                '">' +
                (value
                    ? formatNumber(value)
                    : ''
                ) +
                '</td>';
        }

        html += '</tr>';
    });

    html +=
        '</tbody></table></div>';

    box.innerHTML = html;
}

    function heatColor(ratio){
        ratio=Math.max(0,Math.min(1,ratio));
        if(ratio<.25)return "rgba(20,159,227,"+(.10+ratio*1.4)+")";
        if(ratio<.60)return "rgba(245,158,11,"+(.18+ratio*.75)+")";
        return "rgba(239,68,68,"+(.25+ratio*.65)+")";
    }

    function renderPilotage(){
        var points=allValidPoints();
        if(!points.length)return;
        var data=computeInsights();
        var hourly=[];for(var h=0;h<24;h++)hourly[h]=[];
        points.forEach(function(x){hourly[x.point.date.getHours()].push(x.point.delta);});
        var hourlyAverage=hourly.map(function(a){return a.length?a.reduce(function(x,y){return x+y;},0)/a.length:0;});
        var positive=hourlyAverage.filter(function(v){return v>0;});
        var baseload=positive.length?Math.min.apply(Math,positive):0;
        var peak=positive.length?Math.max.apply(Math,positive):0;
        var baseloadShare=peak?baseload/peak*100:0;
        var nightShare=data.grandTotal?data.overnight/data.grandTotal*100:0;
        var anomalyRate=data.allPoints.length?data.anomalies.length/data.allPoints.length*100:0;
        var concentration=data.grandTotal&&data.top?data.top.total/data.grandTotal*100:0;
        var score=Math.round(Math.max(0,Math.min(100,100-nightShare*.8-anomalyRate*1.5-baseloadShare*.35-Math.max(0,concentration-65)*.25)));

        var sorted=points.slice().sort(function(a,b){return a.point.timestamp-b.point.timestamp;});
        var middle=sorted.length?sorted[Math.floor(sorted.length/2)].point.timestamp:0;
        var first=0,second=0;
        sorted.forEach(function(x){if(x.point.timestamp<middle)first+=x.point.delta;else second+=x.point.delta;});
        var trend=first?(second-first)/first*100:0;

        var daily={};
        points.forEach(function(x){var k=formatDay(x.point.date);daily[k]=(daily[k]||0)+x.point.delta;});
        var dailyValues=Object.keys(daily).map(function(k){return daily[k];});
        var forecast=dailyValues.length?dailyValues.reduce(function(a,b){return a+b;},0)/dailyValues.length:0;

        setText("ayEnergyScore",score+" / 100");
        setText("ayEnergyScoreMeta",score>=80?"Bon niveau de maitrise":(score>=60?"Points d attention":"Actions prioritaires recommandees"));
        setText("ayBaseload",formatNumber(baseload));
        setText("ayBaseloadMeta",formatNumber(baseloadShare)+" % du pic horaire moyen");
        setText("ayTrend",(trend>=0?"+":"")+formatNumber(trend)+" %");
        setText("ayForecast",formatNumber(forecast));
        setText("ayForecastMeta","Moyenne de "+dailyValues.length+" jour(s) disponible(s)");
        renderRecommendations({score:score,nightShare:nightShare,anomalyRate:anomalyRate,baseloadShare:baseloadShare,trend:trend,concentration:concentration});
    }

    function renderRecommendations(k){
        var box=document.getElementById("ayV5Recommendations");if(!box)return;
        var items=[];
        items.push({title:"Score energie",text:"Le score calcule est de "+k.score+" sur 100.",level:k.score<60?"critical":(k.score<80?"warning":"")});
        if(k.nightShare>=20)items.push({title:"Consommation nocturne",text:formatNumber(k.nightShare)+" % de la consommation est observee entre 22h et 06h. Verifier les arrets et programmations.",level:"warning"});
        else items.push({title:"Consommation nocturne",text:"La part nocturne reste limitee a "+formatNumber(k.nightShare)+" %.",level:""});
        if(k.baseloadShare>=30)items.push({title:"Talon energetique",text:"Le talon represente "+formatNumber(k.baseloadShare)+" % du pic horaire moyen. Rechercher les usages permanents.",level:"warning"});
        if(k.anomalyRate>0)items.push({title:"Anomalies",text:formatNumber(k.anomalyRate)+" % des intervalles sont signales. Consulter l onglet Anomalies.",level:k.anomalyRate>=10?"critical":"warning"});
        if(k.trend>=10)items.push({title:"Derive dans la periode",text:"La seconde moitie de la periode consomme "+formatNumber(k.trend)+" % de plus que la premiere.",level:"warning"});
        if(k.concentration>=60)items.push({title:"Concentration des usages",text:"L usage principal represente "+formatNumber(k.concentration)+" %. Prioriser cet usage dans le plan d actions.",level:""});
        box.innerHTML=items.map(function(x){return '<div class="ay-v5-rec '+x.level+'"><div class="ay-v5-rec-title">'+escapeHtml(x.title)+'</div><div class="ay-v5-rec-text">'+escapeHtml(x.text)+'</div></div>';}).join("");
    }

    function exportAnalysisCsv(){
        var data=computeInsights();
        var rows=[["Usage","Total","Part (%)","Anomalies"]];
        data.totals.forEach(function(x){rows.push([x.series.name,x.total,data.grandTotal?x.total/data.grandTotal*100:0,x.anomalies]);});
        rows.push([]);rows.push(["Anomalies detail"]);rows.push(["Niveau","Usage","Date","Valeur","Reference","Ecart","Score"]);
        data.anomalies.forEach(function(x){rows.push([x.point.severity,x.series.name,formatDate(x.point.date),x.point.delta,x.point.reference,x.point.deviation,x.point.score]);});
        var csv=rows.map(function(row){return row.map(function(v){return '"'+String(v===undefined||v===null?"":v).replace(/"/g,'""')+'"';}).join(";");}).join("\r\n");
        var blob=new Blob(["\uFEFF"+csv],{type:"text/csv;charset=utf-8"});
        var url=URL.createObjectURL(blob);var a=document.createElement("a");a.href=url;a.download="Analyst_V6_"+new Date().toISOString().slice(0,10)+".csv";document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(url);
    }
})();

