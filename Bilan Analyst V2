function allValidPoints(){var out=[];seriesList.forEach(function(s){validPointsForSeries(s).forEach(function(p){out.push({series:s,point:p});});});return out;}
function allAnomalies(){var out=[];seriesList.forEach(function(s){anomalyPointsForSeries(s).forEach(function(p){out.push({series:s,point:p});});});return out.sort(function(a,b){return b.point.score-a.point.score;});}
function computeInsights(){
    var totals=seriesList.map(function(s){return {series:s,total:totalForSeries(s),anomalies:anomalyPointsForSeries(s).length};}).sort(function(a,b){return b.total-a.total;});
    var grand=totals.reduce(function(sum,x){return sum+x.total;},0), allPts=allValidPoints(), anomalies=allAnomalies();
    var overnight=allPts.filter(function(x){var h=x.point.date.getHours();return h<6||h>=22;}).reduce(function(sum,x){return sum+x.point.delta;},0);
    var peak=null;allPts.forEach(function(x){if(!peak||x.point.delta>peak.point.delta)peak=x;});
    return {totals:totals,grandTotal:grand,allPoints:allPts,anomalies:anomalies,overnight:overnight,peak:peak,top:totals.length?totals[0]:null};
}

