async function initialize() {
    if (typeof Chart === "undefined") throw new Error("Chart.js n'est pas disponible.");
    bilans = await scanBilans();
    if (!bilans.length) throw new Error("Aucune ressource Bilan de classe 331 trouvee sous " + ENERGY_SCAN_ROOT + ".");
    bilans.sort(function(a,b){ return String(a.name||a.path||"").localeCompare(String(b.name||b.path||""),"fr",{numeric:true,sensitivity:"base"}); });
    injectHtml();
    await waitForElement("analystDashboard",50);
    bindEvents();
    var select = document.getElementById("analystBilanSelect");
    if (select.options.length > 1) {
        select.selectedIndex = 1;
        selectedBilanPath = select.value;
        await handleBilanChange();
    } else {
        setStatus("Aucun Bilan disponible", "#ef4444");
        setLoading("Aucun Bilan disponible");
    }
}

async function scanBilans() {
    var redy = pageActor.dataStores && pageActor.dataStores.redy;
    if (!redy) throw new Error("Datastore REDY indisponible.");
    var fn = typeof redy._searchWosVariables === "function" ? redy._searchWosVariables.bind(redy) : redy.searchWosVariables.bind(redy);
    var result = await fn({path:ENERGY_SCAN_ROOT,isClasses:[BILAN_CLASS],depth:0,take:0});
    return result && Array.isArray(result.variables) ? result.variables : [];
}
async function searchDailyFiles(path) {
    var result = await pageActor.dataStores.redy.searchWosVariables({path:path,isClasses:[DAILY_CLASS],depth:0,take:0});
    var resources = result && Array.isArray(result.variables) ? result.variables : [];
    return resources.map(function(resource){ return {resource:resource,date:parseDailyResourceDate(resource)}; })
        .filter(function(item){ return item.resource && item.resource.path && item.date; })
        .sort(function(a,b){ return a.date-b.date; });
}
async function loadDailyFile(item) {
    var loaded = await pageActor.dataStores.redy.loadWosVariable(item.resource.path,{withBlob:true});
    if (!loaded || loaded.value === undefined || loaded.value === null || loaded.value === "") throw new Error("Blob absent : " + item.resource.path);
    var parsed = parseDailyContent(decodeBase64(loaded.value), item.resource);
    return {resource:item.resource,resourceDate:item.date,headers:parsed.headers,rows:parsed.rows};
}
async function handleBilanChange() {
    var generation = ++loadGeneration;
    selectedBilanPath = document.getElementById("analystBilanSelect").value;
    clearData();
    if (!selectedBilanPath) { setLoading("Choisissez un Bilan"); setStatus("En attente de selection","#149fe3"); return; }
    setLoading("Recherche des Bilans quotidiens...");
    dailyFiles = await searchDailyFiles(selectedBilanPath);
    if (generation !== loadGeneration) return;
    if (!dailyFiles.length) throw new Error("Aucun fichier quotidien de classe 73 dans ce Bilan.");
    selectedPeriod = "7days"; periodShift = 0; selectedSeriesIndex = 0; selectedAnomalyIndex = 0;
    updatePeriodButtons();
    await loadPeriod();
}
function firstDay(){ return dailyFiles.length ? startOfDay(dailyFiles[0].date) : null; }
function lastDay(){ return dailyFiles.length ? startOfDay(dailyFiles[dailyFiles.length-1].date) : null; }
function periodDays(){ return selectedPeriod === "30days" ? 30 : (selectedPeriod === "today" || selectedPeriod === "yesterday" ? 1 : 7); }
function selectedRange(){
    var first=firstDay(), last=lastDay(); if(!first||!last) return null;
    if(selectedPeriod==="all") return {start:first,end:addDays(last,1),label:formatDay(first)+" -> "+formatDay(last)};
    var days=periodDays(), base=selectedPeriod==="yesterday"?-1:0;
    var end=addDays(addDays(last,1),base+periodShift*days), start=addDays(end,-days);
    return {start:start,end:end,label:formatDay(start)+" -> "+formatDay(addDays(end,-1))};
}
function filesForRange(range){
    var selected=[];
    dailyFiles.forEach(function(item,index){ var t=item.date.getTime(); if(t>=range.start.getTime()&&t<range.end.getTime()) selected.push({item:item,index:index}); });
    if(selected.length && selected[0].index>0) selected.unshift({item:dailyFiles[selected[0].index-1],index:selected[0].index-1,preceding:true});
    return selected;
}
async function loadPeriod(){
    var generation=++loadGeneration, range=selectedRange();
    if(!range) throw new Error("Periode impossible a calculer.");
    var files=filesForRange(range);
    updatePeriodInfo(range,0);
    if(!files.length){ clearData(); showEmpty("Aucun fichier quotidien pour cette periode."); return; }
    setLoading("Chargement de "+files.length+" fichier(s)...");
    var parsed=[];
    for(var i=0;i<files.length;i++){
        if(generation!==loadGeneration) return;
        try { parsed.push(await loadDailyFile(files[i].item)); }
        catch(error){ console.warn("Analyst : fichier ignore",files[i].item.resource.path,error); }
    }
    if(generation!==loadGeneration) return;
    if(!parsed.length) throw new Error("Aucun fichier quotidien n'a pu etre charge.");
    var merged=mergeDailyFiles(parsed), built=buildSeriesFromIndexes(merged);
    built.forEach(function(s){ scoreAnomalies(s.points); s.points=s.points.filter(function(p){ return p.timestamp>=range.start.getTime()&&p.timestamp<range.end.getTime(); }); });
    built=built.filter(function(s){ return s.points.some(function(p){ return p.validDelta; }); });
    if(!built.length) throw new Error("Aucune consommation calculable apres fusion des index.");
    mergedRows=merged.rows; seriesList=built; selectedSeriesIndex=0; selectedAnomalyIndex=0;
    renderSeriesButtons(); renderDashboard(); updatePeriodInfo(range,parsed.length); setLoading("Pret");
}

function decodeBase64(value){
    var binary=atob(value);
    try { var bytes=new Uint8Array(binary.length); for(var i=0;i<binary.length;i++) bytes[i]=binary.charCodeAt(i); if(typeof TextDecoder!=="undefined") return new TextDecoder("utf-8").decode(bytes); }
    catch(error){ console.warn(error); }
    return binary;
}
function normalizeText(value){ return String(value===undefined||value===null?"":value).replace(/^\uFEFF/,"").replace(/\u00a0/g," ").replace(/\r/g,"").trim(); }
function parseNumberValue(value){
    var text=normalizeText(value).replace(/\s/g,""); if(!text) return null;
    if(text.indexOf(",")!==-1&&text.indexOf(".")!==-1){ text=text.lastIndexOf(",")>text.lastIndexOf(".")?text.replace(/\./g,"").replace(",", "."):text.replace(/,/g,""); }
    else text=text.replace(",", ".");
    text=text.replace(/[^0-9+\-.]/g,""); var number=parseFloat(text); return isFinite(number)?number:null;
}
function parseDataDate(value){
    var text=normalizeText(value).replace(/<[^>]*>/g,"").trim(); if(!text) return null;
    var parts=text.split(/\s+/); if(parts.length<2) return null;
    var d=parts[0].replace(/-/g,"/").split("/"), t=parts[1].split(":"); if(d.length!==3||t.length<2) return null;
    var day=parseInt(d[0],10), month=parseInt(d[1],10), year=parseInt(d[2],10), hour=parseInt(t[0],10), minute=parseInt(t[1],10), second=t.length>=3?parseInt(t[2],10):0;
    if(year<100) year=year<=79?2000+year:1900+year;
    var date=new Date(year,month-1,day,hour,minute,second,0);
    return date.getFullYear()===year&&date.getMonth()===month-1&&date.getDate()===day&&date.getHours()===hour&&date.getMinutes()===minute?date:null;
}
function parseDailyResourceDate(resource){
    var text=String(resource&&resource.name?resource.name:"")+" "+String(resource&&resource.path?resource.path:"");
    var marker=text.lastIndexOf(".D"); text=marker>=0?text.substring(marker+2):text.substring(text.lastIndexOf("D")+1);
    var digits=""; for(var i=0;i<text.length;i++){ var c=text.charAt(i); if(c>="0"&&c<="9") digits+=c; else break; }
    var y,m,d;
    if(digits.length>=8){ y=parseInt(digits.substring(0,4),10); m=parseInt(digits.substring(4,6),10); d=parseInt(digits.substring(6,8),10); }
    else if(digits.length>=6){ y=parseInt(digits.substring(0,2),10); y=y<=79?2000+y:1900+y; m=parseInt(digits.substring(2,4),10); d=parseInt(digits.substring(4,6),10); }
    else return null;
    var date=new Date(y,m-1,d); return date.getFullYear()===y&&date.getMonth()===m-1&&date.getDate()===d?date:null;
}
function detectSeparator(lines){
    var candidates=["\t",";","|"], best="\t", count=1;
    for(var i=0;i<Math.min(lines.length,8);i++) candidates.forEach(function(s){ var n=lines[i].split(s).length; if(n>count){count=n;best=s;} });
    return best;
}
function parseDailyContent(content,resource){
    var lines=String(content||"").replace(/^\uFEFF/,"").replace(/<\/?(?:html|body)[^>]*>/gi,"").replace(/\r\n/g,"\n").replace(/\r/g,"\n").split("\n").map(normalizeText).filter(function(l){return l!=="";});
    if(!lines.length) throw new Error("Fichier Bilan vide.");
    var sep=detectSeparator(lines), first=lines[0].split(sep).map(normalizeText), firstDate=parseDataDate(first[0]), headers=[], start=0;
    if(firstDate){ for(var i=1;i<first.length;i++) headers.push("Mesure "+i); }
    else { start=1; headers=first.slice(); if(headers.length&&(headers[0].toLowerCase().indexOf("date")!==-1||headers[0].toLowerCase().indexOf("heure")!==-1)) headers=headers.slice(1); }
    var rows=[];
    for(var n=start;n<lines.length;n++){
        var cols=lines[n].split(sep).map(normalizeText); if(cols.length<2) continue;
        var date=parseDataDate(cols[0]); if(!date) continue;
        rows.push({dateText:cols[0],date:date,timestamp:date.getTime(),values:cols.slice(1).map(parseNumberValue),resourceName:resource.name||"",resourcePath:resource.path||""});
    }
    if(!rows.length) throw new Error("Aucune date reconnue dans "+(resource.name||resource.path||"le Bilan")+".");
    var max=0; rows.forEach(function(r){max=Math.max(max,r.values.length);}); while(headers.length>max) headers.shift(); while(headers.length<max) headers.push("Mesure "+(headers.length+1));
    return {headers:headers,rows:rows};
}
function mergeDailyFiles(files){
    var headers=[], lookup={}; files.forEach(function(f){if(f.headers.length>headers.length) headers=f.headers.slice(); f.rows.forEach(function(r){lookup[r.timestamp]=r;});});
    var rows=Object.keys(lookup).map(function(k){return lookup[k];}).sort(function(a,b){return a.timestamp-b.timestamp;});
    var max=0; rows.forEach(function(r){max=Math.max(max,r.values.length);}); while(headers.length<max) headers.push("Mesure "+(headers.length+1));
    return {headers:headers,rows:rows};
}
function buildSeriesFromIndexes(merged){
    return merged.headers.map(function(header,col){
        var points=[];
        merged.rows.forEach(function(row){ var v=row.values[col]; if(v!==null&&v!==undefined&&isFinite(v)) points.push({indexValue:v,delta:null,date:row.date,timestamp:row.timestamp,label:row.dateText,duration:null,validDelta:false,resetDetected:false,gapDetected:false,reference:null,deviation:null,score:0,severity:"normal"}); });
        points.sort(function(a,b){return a.timestamp-b.timestamp;});
        for(var i=1;i<points.length;i++){
            var p=points[i], prev=points[i-1]; p.duration=p.timestamp-prev.timestamp; var delta=p.indexValue-prev.indexValue;
            if(delta<0){p.resetDetected=true;continue;} p.delta=delta;p.validDelta=true;
        }
        var durations=points.map(function(p){return p.duration;}).filter(function(v){return v>0;}), normal=median(durations);
        points.forEach(function(p){p.gapDetected=normal>0&&p.duration!==null&&p.duration>normal*1.5;});
        return {name:header||("Mesure "+(col+1)),color:COLORS[col%COLORS.length],points:points};
    });
}

function scoreAnomalies(points){
    var buckets=[]; for(var h=0;h<24;h++) buckets.push([]);
    points.forEach(function(p){if(p.validDelta&&p.delta!==null&&isFinite(p.delta)&&p.delta>=0) buckets[p.date.getHours()].push(p.delta);});
    var profiles=buckets.map(function(values){var center=median(values),mad=median(values.map(function(v){return Math.abs(v-center);}));return {median:center,mad:mad,count:values.length};});
    points.forEach(function(p){
        if(!p.validDelta||p.delta===null||!isFinite(p.delta)||p.delta<0)return;
        var ref=profiles[p.date.getHours()];p.reference=ref.median;p.deviation=p.delta-ref.median;
        if(ref.count<MIN_REFERENCE_COUNT){p.score=0;p.severity="normal";return;}
        var scale=Math.max(ref.mad*1.4826,Math.abs(ref.median)*0.15,0.01);p.score=Math.abs(p.deviation)/scale;
